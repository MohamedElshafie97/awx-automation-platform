# Copy to .env, then append generated secrets:
#   cp .env.example .env && ../scripts/generate-secrets.sh >> .env
# .env holds secrets - it's git-ignored, keep a copy in your password manager.

AWX_VERSION=24.6.1
AWX_EE_IMAGE=quay.io/ansible/awx-ee:24.6.1
AWX_HTTP_PORT=8080

AWX_PG_DATABASE=awx
AWX_PG_USER=awx
AWX_PG_HOST=postgres
AWX_PG_PORT=5432

AWX_ADMIN_USER=admin
AWX_ADMIN_EMAIL=admin@example.com

# Outgoing mail for job notifications
AWX_EMAIL_HOST=smtp.example.com
AWX_EMAIL_PORT=587
AWX_EMAIL_FROM=awx@example.com

# Generated - do not edit by hand, and never change AWX_SECRET_KEY after
# the first start: every stored credential is encrypted with it.
# AWX_SECRET_KEY=
# AWX_PG_PASSWORD=
# AWX_BROADCAST_WEBSOCKET_SECRET=
# DJANGO_SUPERUSER_PASSWORD=
